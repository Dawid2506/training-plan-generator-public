# --- App ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Database (Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5434/dbname

# --- Local Postgres (docker-compose.yaml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=training_plan_db

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# --- Initial SUPER_ADMIN account (src/utils/setup.ts, optional) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme
INITIAL_ADMIN_USERNAME=superadmin

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
# Model used by the AI coach and the plan generator. Also recorded on every
# TokenUsage row, so changing it here changes what usage reporting attributes.
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- AI coach limits (all optional, defaults in src/services/coach/config.ts) ---
# Model round-trips per message; the last one runs without tools.
COACH_MAX_ITERATIONS=5
# Total tool executions per message.
COACH_MAX_TOOL_CALLS=12
# Wall-clock budget for one answer, milliseconds.
COACH_DEADLINE_MS=60000
# Cumulative tokens per message before the coach must answer with what it has.
COACH_TOKEN_BUDGET=60000
# Rolling 24h token ceiling per user.
COACH_DAILY_TOKEN_CEILING=500000
# Sliding-window burst limit per user.
COACH_BURST_LIMIT=10
COACH_BURST_WINDOW_MS=300000

# --- Strava OAuth ---
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# --- SMTP (src/services/mail.service.ts) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
