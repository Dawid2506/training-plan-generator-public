generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  username       String         @unique
  email          String         @unique
  password       String
  role           UserRole       @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  messagesUsed   Int            @default(0)
  limitResetDate DateTime       @default(now())
  chatSessions   ChatSession[]
  messages       Message[]
  tokenUsage     TokenUsage[]
  trainingPlans  TrainingPlan[]
  userActivities UserActivity[]
}

model UserActivity {
  id                 String         @id @default(uuid())
  userId             String
  sourceFileName     String
  format             String
  sourceType         ActivitySource @default(FILE)
  externalActivityId BigInt?
  workoutFocus       String
  payload            Json
  createdAt          DateTime       @default(now())
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalActivityId])
  @@index([userId])
  @@index([createdAt])
  @@index([sourceType])
  @@index([externalActivityId])
}

model TrainingPlan {
  id        String   @id @default(uuid())
  userId    String
  plan      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model TokenUsage {
  id               String   @id @default(uuid())
  userId           String
  sessionId        String?
  messageId        String?
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  model            String   @default("gpt-3.5-turbo")
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ChatSession {
  id        String    @id @default(uuid())
  userId    String
  title     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id        String        @id @default(uuid())
  sessionId String
  userId    String
  content   String
  isAnswer  Boolean
  status    MessageStatus @default(SENT)
  createdAt DateTime      @default(now())
  session   ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

enum MessageStatus {
  SENDING
  SENT
  ERROR
}

enum ActivitySource {
  FILE
  STRAVA
}

enum UserRole {
  USER
  PREMIUM
  ADMIN
  SUPER_ADMIN
}
