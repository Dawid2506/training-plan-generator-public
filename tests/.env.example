# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# Where the app is served. Both must already be running; the suite does not start them.
BASE_URL=http://localhost:5173
API_URL=http://localhost:3000

# An existing account with the ADMIN role. Needed only by the specs tagged @admin
# (the interval-plans table needs an account that already owns plans).
# Leave blank and those specs skip themselves.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Used by the global teardown to delete the users the suite created.
# Leave blank and the teardown reads POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# out of ../backend/.env instead, which is usually what you want.
DATABASE_URL=
